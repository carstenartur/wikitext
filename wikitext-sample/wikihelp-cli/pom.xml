<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.hammer</groupId>
        <artifactId>wikitext</artifactId>
        <version>1.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>wikihelp-cli</artifactId>
    <name>WikiHelp Command Line</name>
    <dependencies>
        <dependency>
            <groupId>org.hammer</groupId>
            <artifactId>wikihelp-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hammer</groupId>
            <artifactId>wikihelp-source-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hammer</groupId>
            <artifactId>wikihelp-source-mediawiki</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hammer</groupId>
            <artifactId>wikihelp-source-gitlab</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hammer</groupId>
            <artifactId>wikihelp-source-confluence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hammer</groupId>
            <artifactId>wikihelp-source-eclipsepedia</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hammer</groupId>
            <artifactId>wikihelp-renderer-eclipse-help</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>cli-integration-self-test</id>
                        <phase>test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <java classname="org.hammer.wikihelp.cli.CliIntegrationSelfTest"
                                      fork="true"
                                      failonerror="true">
                                    <classpath refid="maven.test.classpath"/>
                                </java>
                                <java classname="org.hammer.wikihelp.cli.RemoteSourceSelfTest"
                                      fork="true"
                                      failonerror="true">
                                    <jvmarg value="--add-modules=jdk.httpserver"/>
                                    <classpath refid="maven.test.classpath"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
