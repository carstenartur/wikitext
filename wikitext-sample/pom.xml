<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.hammer</groupId>
    <artifactId>wikitext</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>WikiHelp</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <tycho-version>5.0.4</tycho-version>
        <target.classifier></target.classifier>
        <target.file>rcptarget.target</target.file>
        <wikihelp.mode>offline</wikihelp.mode>
        <wikihelp.cache>target/wikihelp-cache</wikihelp.cache>
    </properties>

    <modules>
        <module>wikihelp-core</module>
        <module>wikihelp-source-local</module>
        <module>wikihelp-source-mediawiki</module>
        <module>wikihelp-source-gitlab</module>
        <module>wikihelp-source-confluence</module>
        <module>wikihelp-source-eclipsepedia</module>
        <module>wikihelp-renderer-eclipse-help</module>
        <module>wikihelp-cli</module>
        <module>rcptarget</module>
        <module>wikitext-sample</module>
    </modules>

    <developers>
        <developer>
            <id>chammer</id>
            <name>Carsten Hammer</name>
            <email>carsten.hammer@t-online.de</email>
        </developer>
    </developers>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho-version}</version>
                <extensions>true</extensions>
            </plugin>
        </plugins>
    </build>
</project>
