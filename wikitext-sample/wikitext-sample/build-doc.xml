<?xml version="1.0" encoding="UTF-8"?>
<!--
    Wiki source synchronization and Eclipse Help generation are intentionally
    separate stages. The Java source adapters populate a deterministic cache;
    Mylyn WikiText then renders supported source markup into Eclipse Help.
-->
<project name="wikihelp" default="all">
    <property name="wikihelp.mode" value="offline"/>
    <property name="wikihelp.cache" location="target/wikihelp-cache"/>

    <path id="wikihelp.classpath">
        <pathelement location="../wikihelp-core/target/classes"/>
        <pathelement location="../wikihelp-source-local/target/classes"/>
        <pathelement location="../wikihelp-source-mediawiki/target/classes"/>
        <pathelement location="../wikihelp-source-gitlab/target/classes"/>
        <pathelement location="../wikihelp-source-confluence/target/classes"/>
        <pathelement location="../wikihelp-source-eclipsepedia/target/classes"/>
        <pathelement location="../wikihelp-renderer-eclipse-help/target/classes"/>
        <pathelement location="../wikihelp-cli/target/classes"/>
    </path>

    <target name="clean">
        <delete dir="nl" failonerror="false"/>
        <delete file="wikihelp_toc.xml" failonerror="false"/>
        <delete file="target/wikihelp-render.xml" failonerror="false"/>
    </target>

    <target name="sync" depends="clean"
            description="Select source pages, synchronize their cache, and prepare the render plan">
        <mkdir dir="target"/>
        <java classname="org.hammer.wikihelp.cli.WikiHelpCli"
              classpathref="wikihelp.classpath"
              fork="true"
              failonerror="true">
            <sysproperty key="wikihelp.mode" value="${wikihelp.mode}"/>
            <arg value="--config"/><arg file="wikihelp.properties"/>
            <arg value="--cache"/><arg file="${wikihelp.cache}"/>
            <arg value="--output"/><arg file="nl"/>
            <arg value="--ant"/><arg file="target/wikihelp-render.xml"/>
            <arg value="--toc"/><arg file="wikihelp_toc.xml"/>
            <arg value="--css"/><arg file="book.css"/>
        </java>
    </target>

    <target name="render" depends="sync"
            description="Render cached source pages as Eclipse Help">
        <ant antfile="target/wikihelp-render.xml" inheritAll="true" target="render"/>
    </target>

    <target name="all" depends="render"/>
</project>
