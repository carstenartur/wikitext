<?xml version="1.0" encoding="UTF-8"?>
<!--
    Generate reproducible Eclipse help from checked-in MediaWiki sources.
    The former live Eclipsepedia API integration was retired when Eclipsepedia
    became a read-only static archive.
-->
<project name="wikitext-help" default="all">
    <path id="wikitext.tasks.classpath">
        <fileset dir="lib">
            <include name="org.eclipse.mylyn.wikitext.*core*.jar"/>
        </fileset>
    </path>

    <taskdef classpathref="wikitext.tasks.classpath"
             resource="org/eclipse/mylyn/wikitext/core/util/anttask/tasks.properties"/>

    <target name="clean">
        <delete dir="nl" failonerror="false"/>
        <delete file="GEF_toc.xml" failonerror="false"/>
    </target>

    <target name="init" depends="clean">
        <mkdir dir="nl/en"/>
        <mkdir dir="nl/de"/>
        <copy file="book.css" tofile="nl/en/book.css" overwrite="true"/>
        <copy file="book.css" tofile="nl/de/book.css" overwrite="true"/>
        <copy file="src-doc/en/GEF.mediawiki" tofile="nl/en/GEF.mediawiki" overwrite="true"/>
        <copy file="src-doc/de/GEF.mediawiki" tofile="nl/de/GEF.mediawiki" overwrite="true"/>
    </target>

    <target name="generate-online-help" depends="init"
            description="Generate Eclipse help from checked-in MediaWiki source">
        <wikitext-to-eclipse-help markuplanguage="MediaWiki"
                                  navigationImages="false"
                                  validate="true"
                                  failonvalidationerror="true"
                                  formatoutput="true"
                                  defaultAbsoluteLinkTarget="mylyn_external"
                                  helpPrefix="nl/en"
                                  title="Graphical Editing Framework"
                                  overwrite="true"
                                  xmlFilenameFormat="$1_toc.xml">
            <fileset dir="nl/en" includes="GEF.mediawiki"/>
            <stylesheet url="book.css"/>
        </wikitext-to-eclipse-help>

        <wikitext-to-eclipse-help markuplanguage="MediaWiki"
                                  navigationImages="false"
                                  validate="true"
                                  failonvalidationerror="true"
                                  formatoutput="true"
                                  defaultAbsoluteLinkTarget="mylyn_external"
                                  helpPrefix="nl/de"
                                  title="Graphical Editing Framework"
                                  overwrite="true"
                                  xmlFilenameFormat="$1_toc.xml">
            <fileset dir="nl/de" includes="GEF.mediawiki"/>
            <stylesheet url="book.css"/>
        </wikitext-to-eclipse-help>

        <copy file="nl/en/GEF_toc.xml" tofile="GEF_toc.xml" overwrite="true"/>
        <delete>
            <fileset dir="nl" includes="**/*.mediawiki"/>
        </delete>
    </target>

    <target name="all" depends="generate-online-help"/>
</project>
